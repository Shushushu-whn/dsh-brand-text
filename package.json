{
  "name": "dsh-brand-text",
  "version": "0.3.0",
  "description": "Unified branding for the DSH (DeepSeek Harness) Web client: sidebar name & logo, hero copy, document title, favicon and PWA manifest — plus a settings panel (/brand-studio/) and in-page double-click editing.",
  "license": "MIT",
  "author": "Shushushu-whn",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "branding",
    "logo"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shushushu-whn/dsh-brand-text.git"
  },
  "homepage": "https://github.com/Shushushu-whn/dsh-brand-text#readme",
  "bugs": {
    "url": "https://github.com/Shushushu-whn/dsh-brand-text/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
