{
  "name": "dsh-brand-text",
  "version": "0.4.0",
  "description": "DSH (DeepSeek Harness) branding in two layers: (1) basics — sidebar logo, sidebar name, hero title, document title, favicon and PWA manifest; (2) watermark — a translucent, opacity-tunable overlay on the page plus a stamping ledger that writes 'why this was added / what job is running' into project files and folders. Ships a settings panel (/brand-studio/) and in-page double-click editing.",
  "license": "MIT",
  "author": "Shushushu-whn <230179612@aa.seu.edu.cn>",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "branding",
    "logo",
    "watermark"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shushushu-whn/dsh-brand-text.git"
  },
  "homepage": "https://github.com/Shushushu-whn/dsh-brand-text#readme",
  "bugs": {
    "url": "https://github.com/Shushushu-whn/dsh-brand-text/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
